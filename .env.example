# Copy to .env for local use: node --env-file=.env server.js
# CF injects PORT automatically; never set a fixed port in its manifest.
PORT=3000
NODE_ENV=development
# Local-only, temporary data. CF/production requires redis.
STATE_STORE=memory
# REDIS_URL=rediss://user:password@redis-host:6379
# REDIS_SERVICE_NAME=cross-reference-redis
# Required whenever Redis is used; same secret on every CF instance.
# Generate once: openssl rand -base64 32
# COOKIE_ENCRYPTION_KEY=<base64-encoded 32 random bytes>
STATE_KEY_PREFIX=cross-reference:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Headless on every platform; CF always enforces headless mode.
BROWSER_HEADLESS=true
# Optional outbound proxy; also forwarded to Chromium by the browser launcher.
# HTTP_PROXY=http://proxy-host:8080
# HTTPS_PROXY=http://proxy-host:8080
# NO_PROXY=.internal.example,localhost,127.0.0.1
# PUPPETEER_SKIP_DOWNLOAD=true
# SPARK_DATABASE_PATH=/app/data/sparkplug.db
# BRAKE_DATABASE_PATH=/app/data/brakeoil.db
MAHLE_URL=https://market.dat881.com/intell/dir29/maleApp
MANN_URL=https://www.mann-filter.com/cn-zh/catalog.html
PUROLATOR_URL=https://purolator.51cjml.com
TORA_URL=https://baowang.51cjml.com
BOSCH_URL=https://boschaftermarket.com.cn/Dealerportal/gb/cn/parts
NGK_URL=https://market.dat881.com/intell/ngk/ngkApp
TORCH_URL=https://market.dat881.com/intell/dir19/xhjApp
BENDIX_AU_URL=https://www.bendix.com.au/catalogue
BENDIX_MY_URL=https://www.bendix.com.my/en-my/catalogue
ZF_CATALOGUE_URL=https://aftermarket.zf.com/cn/catalog/?country=CN

# Public browser assets; these URLs are visible to users.
# TAILWIND_URL=https://cdn.tailwindcss.com
